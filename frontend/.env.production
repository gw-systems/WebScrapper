# Frontend Production Environment Variables
# These are embedded during build time

# Backend WebSocket URL (use wss:// for HTTPS deployments)
VITE_WS_URL=wss://your-domain.com

# Backend API URL (optional, defaults to same origin)
VITE_API_URL=https://your-domain.com

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================
# 1. Replace "your-domain.com" with your actual deployment domain
# 2. Use wss:// (WebSocket Secure) for production HTTPS sites
# 3. Use ws:// only for local development
# 4. These variables are embedded at BUILD time, not runtime
# 5. Rebuild the frontend after changing these values: npm run build
