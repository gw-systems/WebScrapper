# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# Run 'node scripts/generate-secrets.js' to generate secure secrets
# Run 'node scripts/validate-secrets.js' to validate your configuration

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webscraper
DB_USER=webscrapper_user
DB_PASSWORD=your_database_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# BROWSER POOL CONFIGURATION
# ============================================================================
# Maximum number of concurrent browser instances globally
MAX_BROWSERS_TOTAL=10
# Maximum number of browser instances per user
MAX_BROWSERS_PER_USER=2
# Time-to-live for idle browsers (milliseconds) - 5 minutes default
BROWSER_TTL_MS=300000

# ============================================================================
# REQUEST TIMEOUT CONFIGURATION
# ============================================================================
# Timeout for category scraping operations (milliseconds) - 5 minutes default
SCRAPING_TIMEOUT_MS=300000
# Timeout for search operations (milliseconds) - 2 minutes default
SEARCH_TIMEOUT_MS=120000

# ============================================================================
# RATE LIMITING
# ============================================================================
# Maximum WebSocket connections per IP address
MAX_CONNECTIONS_PER_IP=100
# Maximum WebSocket messages per minute per IP
MAX_MESSAGES_PER_MINUTE=300
# Rate limit time window (milliseconds)
RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# CRITICAL: Generate these using 'node scripts/generate-secrets.js'
# NEVER use default values in production!
# Minimum length: 32 characters (64 hex characters recommended)

API_KEY_SECRET=GENERATE_THIS_SECRET_DO_NOT_USE_THIS_VALUE
JWT_SECRET=GENERATE_THIS_SECRET_DO_NOT_USE_THIS_VALUE

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================================================
# PRODUCTION ENVIRONMENT EXAMPLE
# ============================================================================
# NODE_ENV=production
# PORT=5000
# FRONTEND_URL=https://your-domain.com
# DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_PASSWORD=<use AWS Secrets Manager or similar>
# API_KEY_SECRET=<load from secrets manager>
# JWT_SECRET=<load from secrets manager>
# MAX_BROWSERS_TOTAL=20
# MAX_BROWSERS_PER_USER=3
# LOG_LEVEL=warn

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production:
# ✓ 1. Set NODE_ENV=production
# ✓ 2. Generate new secrets using 'node scripts/generate-secrets.js'
# ✓ 3. Use a strong database password (20+ characters)
# ✓ 4. Configure FRONTEND_URL to your actual domain (with HTTPS)
# ✓ 5. Adjust browser limits based on server capacity
# ✓ 6. Ensure all .env files are in .gitignore
# ✓ 7. Run 'node scripts/validate-secrets.js' before deployment
# ✓ 8. Consider using a secrets manager (AWS Secrets Manager, HashiCorp Vault)
# ✓ 9. Set up monitoring and alerting
# ✓ 10. Configure log retention and rotation
